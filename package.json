{
  "name": "forge",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "type": "module",
  "scripts": {
    "dev:frontend": "npm run dev -w @forge/frontend",
    "build:frontend": "npm run build -w @forge/frontend",
    "preview:frontend": "npm run preview -w @forge/frontend",
    "dev:desktop": "npm run tauri dev -w @forge/desktop",
    "build:desktop": "npm run build:win -w @forge/desktop"
  }
}
