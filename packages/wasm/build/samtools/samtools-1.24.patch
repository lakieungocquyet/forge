diff -ruN samtools-1.24-orig/bam_sort.c samtools-1.24-wasm/bam_sort.c
--- samtools-1.24-orig/bam_sort.c	2026-11-25 14:03:54.833250983 +0700
+++ samtools-1.24-wasm/bam_sort.c	2026-11-25 14:05:54.608745233 +0700
@@ -3181,18 +3181,10 @@
         in_mem[i].from = pos;
         in_mem[i].to = pos + w[i].buf_len;
         pos += w[i].buf_len; rest -= w[i].buf_len;
-        pthread_create(&tid[i], &attr, worker, &w[i]);
-    }
-    for (i = 0; i < n_threads; ++i) {
-        pthread_join(tid[i], 0);
-        if (w[i].error != 0) {
-            errno = w[i].error;
-            print_error_errno("sort", "failed to sort block %d", i);
-            n_failed++;
-        }
     }
     free(w);
     free(tid);
+    worker(&w[0]);
 
     return n_failed ? -1 : n_threads;
 }
