diff -ruN samtools-1.24-orig/Makefile samtools-1.24-wasm/Makefile
--- samtools-1.24-orig/Makefile	2026-11-25 14:03:54.833250983 +0700
+++ samtools-1.24-wasm/Makefile	2026-11-25 14:04:58.966226238 +0700
@@ -132,7 +132,7 @@
 	echo '#define SAMTOOLS_CC "$(CC)"' >> $@
 	echo '#define SAMTOOLS_CPPFLAGS "$(CPPFLAGS)"' >> $@
 	echo '#define SAMTOOLS_CFLAGS "$(CFLAGS)"' >> $@
-	echo '#define SAMTOOLS_LDFLAGS "$(LDFLAGS)"' >> $@
+	echo '#define SAMTOOLS_LDFLAGS "-s ERROR_ON_UNDEFINED_SYMBOLS=0 -O2"' >> $@
 	echo '#define SAMTOOLS_HTSDIR "$(HTSDIR)"' >> $@
 	echo '#define SAMTOOLS_LIBS "$(LIBS)"' >> $@
 	echo '#define SAMTOOLS_CURSES_LIB "$(CURSES_LIB)"' >> $@
@@ -150,7 +150,7 @@
 
 
